# Where the FastAPI backend is listening. Server-side only — never NEXT_PUBLIC_,
# because the backend has no authentication and must not be reachable from a browser.
API_BASE_URL=http://127.0.0.1:8000

# Required for the copilot chat. Without it the dashboard still works in full and
# the chat drawer explains that it is disabled rather than failing at request time.
ANTHROPIC_API_KEY=

# Model used by the copilot. Any Anthropic model id.
COPILOT_MODEL=claude-sonnet-5
