# Copy to .env and fill in. Never commit .env — see .gitignore.

# ─── Database ────────────────────────────────────────────────────────────────
# Local development (default): no server needed.
DATABASE_URL=sqlite+aiosqlite:///./ipo_copilot.db
#
# Production. Apply migrations/001_init.sql first; pgvector requires PostgreSQL.
#   psql "$DATABASE_URL" -f migrations/001_init.sql
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres

SQL_ECHO=false

# ─── Scheduler ───────────────────────────────────────────────────────────────
# IPOs below this grey-market premium percentage are never bid on.
MIN_GMP=10.0

# Only "seeded" ships. See app/providers/gmp.py to add a real source.
GMP_PROVIDER=seeded

# ─── Privacy ─────────────────────────────────────────────────────────────────
# REQUIRED in production. Random, secret, and never rotated without re-hashing
# every stored PAN. Generate with:  python -c "import secrets;print(secrets.token_hex(32))"
PAN_HASH_SALT=

# ─── Copilot (Step 2, not yet wired) ─────────────────────────────────────────
# ANTHROPIC_API_KEY=
# Must match the vector(N) width in migrations/001_init.sql.
EMBEDDING_DIM=1536
